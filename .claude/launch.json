{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.app:app", "--host", "127.0.0.1", "--port", "8765"],
      "port": 8765
    },
    {
      "name": "ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "streamlit", "run", "frontend/app.py", "--server.address", "127.0.0.1", "--server.port", "8501", "--server.headless", "true", "--browser.gatherUsageStats", "false"],
      "port": 8501
    }
  ]
}
